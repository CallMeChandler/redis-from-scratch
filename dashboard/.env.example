# Where the C++ redis-server primary listens.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional replica. Set REPLICA_HOST=none to show it as NOT CONFIGURED.
REPLICA_HOST=127.0.0.1
REPLICA_PORT=6380

# Dashboard HTTP port (Railway injects PORT automatically).
PORT=3000

# Optional tuning (milliseconds).
# REDIS_CONNECT_TIMEOUT_MS=2000
# REDIS_COMMAND_TIMEOUT_MS=5000
